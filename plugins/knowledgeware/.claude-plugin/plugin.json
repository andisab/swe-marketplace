{
  "name": "knowledgeware",
  "description": "Style-driven deliverable suite: slide decks (PowerPoint or HTML), multi-page HTML knowledge bases, and diagrams/data charts (Mermaid, SVG, or draw.io) that all render from one shared brand/style registry. Works out of the box with 5 built-in styles; add your own brand once and every deliverable matches. A librarian agent keeps sites and decks current: what's due, update plans, and scheduled fact-check sweeps.",
  "version": "1.12.3",
  "author": {
    "name": "Andis A. Blukis",
    "email": "andis.blukis@gmail.com",
    "url": "https://github.com/andisab"
  },
  "homepage": "https://github.com/andisab/swe-marketplace",
  "repository": "https://github.com/andisab/swe-marketplace",
  "license": "MIT",
  "keywords": [
    "slides",
    "pptx",
    "reveal.js",
    "knowledge-base",
    "diagrams",
    "drawio",
    "brandbook",
    "styles",
    "design-tokens",
    "maintenance"
  ],
  "agents": [
    "./agents/librarian.md"
  ],
  "commands": [
    "./commands/librarian.md",
    "./commands/kb-maintain.md"
  ],
  "skills": [
    "./skills/slideware",
    "./skills/knowledgebase",
    "./skills/chartware",
    "./skills/brandware"
  ],
  "mcpServers": {
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp@1.10.0"
      ]
    }
  },
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/andisab/swe-marketplace/blob/main/plugins/knowledgeware/README.md",
  "supportUrl": "https://github.com/andisab/swe-marketplace/issues",
  "privacyPolicyUrl": "https://github.com/andisab/swe-marketplace/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/andisab/swe-marketplace/blob/main/LICENSE"
}
