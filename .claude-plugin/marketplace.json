      "name": "research-team",
      "source": "./plugins/research-team",
      "description": "Multi-agent research system for comprehensive topic investigation. The research-team:coordinator skill decomposes a topic into subtopics, spawns parallel research-specialist subagents, and delegates synthesis to a report-writer — all from the main agent thread so nested-spawn constraints don't apply. Reports are plain Markdown by default, with Obsidian and Joplin profiles and five report templates.",
      "version": "1.3.0",
      "author": {
        "name": "Andis A. Blukis",
        "email": "andis.blukis@gmail.com",
        "url": "https://github.com/andisab"
