#!/bin/sh
# Stops a commit whose staged files leave a generated plugin.json, or the
# README's catalog tables, out of step with marketplace.json, as CI would.
#
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
# Skip for one commit:    git commit --no-verify

staged=$(mktemp -d) || exit 1
trap 'rm -rf "$staged"' EXIT

# Check what is being committed, not what is in the working tree.
git checkout-index --all --prefix="$staged/" || exit 1

status=0
run_check() {
    if ! output=$(python3 "$@" 2>&1); then
        echo "$output"
        status=1
    fi
}

run_check "$staged/scripts/synthesize-plugin-manifests.py" --check
run_check "$staged/scripts/check-readme-catalog.py"

if [ "$status" -ne 0 ]; then
    echo
    echo "pre-commit: the staged changes leave a file above out of step with marketplace.json."
    echo "Regenerate (python scripts/synthesize-plugin-manifests.py) or fix the README, stage it and commit again."
fi
exit "$status"
